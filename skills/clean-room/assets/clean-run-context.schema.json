{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clean-Room Clean Run Context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "context_id",
    "task_id",
    "created_at",
    "target_profile",
    "native_artifacts",
    "formatting_rules",
    "clean_artifacts",
    "implementation",
    "coordination_boundary",
    "approved_public_reference_roots",
    "clean_isolation",
    "model_preferences",
    "user_rules"
  ],
  "properties": {
    "context_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "target_profile": {
      "$ref": "#/$defs/target_profile"
    },
    "native_artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "formatting_rules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "clean_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clean_root",
        "handoff_package",
        "behavior_specs",
        "skeleton_manifest",
        "implementation_plan",
        "implementation_report",
        "qc_report"
      ],
      "properties": {
        "clean_root": {
          "$ref": "#/$defs/clean_path"
        },
        "handoff_package": {
          "$ref": "#/$defs/clean_path"
        },
        "behavior_specs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/clean_path"
          }
        },
        "skeleton_manifest": {
          "$ref": "#/$defs/clean_path"
        },
        "implementation_plan": {
          "$ref": "#/$defs/clean_path"
        },
        "implementation_report": {
          "$ref": "#/$defs/clean_path"
        },
        "qc_report": {
          "$ref": "#/$defs/clean_path"
        },
        "open_questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/clean_path"
          }
        },
        "abstract_delta_tickets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/clean_path"
          }
        }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation_root_refs",
        "planner_role",
        "implementer_role",
        "shell_verification"
      ],
      "properties": {
        "implementation_root_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "root_id",
              "env_ref",
              "access"
            ],
            "properties": {
              "root_id": {
                "type": "string",
                "minLength": 1
              },
              "env_ref": {
                "type": "string",
                "pattern": "^CLEAN_ROOM_IMPLEMENTATION_ROOTS\\[[0-9]+\\]$"
              },
              "access": {
                "enum": [
                  "read-only-for-agent-2",
                  "read-write-for-agent-3"
                ]
              }
            }
          }
        },
        "planner_role": {
          "const": "clean-architect"
        },
        "implementer_role": {
          "const": "clean-qa-editor"
        },
        "shell_verification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "agent3_shell_allowed",
            "cwd_policy"
          ],
          "properties": {
            "agent3_shell_allowed": {
              "type": "boolean"
            },
            "cwd_policy": {
              "const": "implementation-root"
            }
          }
        }
      }
    },
    "coordination_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent0_to_clean_roles",
        "agent3_to_agent0",
        "interim_agent3_reports"
      ],
      "properties": {
        "agent0_to_clean_roles": {
          "const": "durable-sanitized-artifacts-only"
        },
        "agent3_to_agent0": {
          "const": "terminal-report-only"
        },
        "interim_agent3_reports": {
          "const": false
        }
      }
    },
    "approved_public_reference_roots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/clean_path"
      }
    },
    "clean_isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "clean_agents_start_cwd",
        "source_mounted"
      ],
      "properties": {
        "mode": {
          "const": "clean-workspace"
        },
        "clean_agents_start_cwd": {
          "const": "clean_root"
        },
        "source_mounted": {
          "const": false
        }
      }
    },
    "model_preferences": {
      "$ref": "#/$defs/model_preferences"
    },
    "user_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clean_safe"
      ],
      "properties": {
        "clean_safe": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "clean_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*(?:source-index|coverage-ledger|evidence-ledger|task-manifest)\\.json).+"
    },
    "target_profile": {
      "enum": [
        "openspec-delta",
        "gsd-planning-package",
        "speckit-feature-folder",
        "kiro-spec-folder"
      ]
    },
    "role": {
      "enum": [
        "clean-architect",
        "clean-qa-editor"
      ]
    },
    "model_preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_model"
      ],
      "properties": {
        "default_model": {
          "type": "string",
          "minLength": 1
        },
        "domain_overrides": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "clean": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "role_overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "model"
            ],
            "properties": {
              "role": {
                "$ref": "#/$defs/role"
              },
              "model": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
